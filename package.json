    "@fontsource/anuphan": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
