# Copy to .env for local runs. On Fly.io set these with `fly secrets set`; never commit real values.
DATABASE_URL=
# Optional: the provider's CA file, so the database server is verified as well as encrypted.
DATABASE_CA=
# Comma-separated origins allowed to call the API: the web app plus the phone app shells.
ALLOW_ORIGIN=https://app.example.com,capacitor://localhost,https://localhost
APP_URL=https://app.example.com
FINNHUB_API_KEY=
SEC_USER_AGENT=
RESEND_API_KEY=
MAIL_FROM=JOD <no-reply@example.com>
FIREBASE_SERVICE_ACCOUNT=
# Build-time, for the web and phone apps: where the sync server lives.
VITE_SYNC_SERVER=https://jod-sync.fly.dev
